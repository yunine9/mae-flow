{
  "start": "config_confirm",
  "state_file": ".mae-flow.json",
  "compatibility_entries": [
    "rf_verify",
    "grill_ask",
    "design",
    "test_blueprint",
    "story_ask",
    "build_plan",
    "archive_confirm",
    "archive"
  ],
  "source_patterns": [
    "(^|/)(service|src|include|lib|app|modules?)/"
  ],
  "specs_truth": "(^|/)openspec/specs/",
  "steps": {
    "config_confirm": {
      "title": "配置确认",
      "user_ack": true,
      "require_sets": [
        "工号",
        "基线分支",
        "单号",
        "单号类型",
        "需求文档",
        "编译方式",
        "UT生成方式",
        "UT运行命令"
      ],
      "next": "workflow_select"
    },
    "workflow_select": {
      "title": "交付方式选择",
      "user_ack": true,
      "choice_key": "workflow",
      "choices": [
        "full",
        "hotfix",
        "tweak",
        "review"
      ],
      "choice_answers": {
        "full": [
          "完整开发"
        ],
        "hotfix": [
          "已定位问题修复"
        ],
        "tweak": [
          "局部修改"
        ],
        "review": [
          "处理评审意见"
        ]
      },
      "next": "code_reviewer_ask"
    },
    "code_reviewer_ask": {
      "title": "独立 CODE Reviewer 选择",
      "user_ack": true,
      "choice_key": "code_reviewer",
      "choices": [
        "disabled",
        "enabled"
      ],
      "choice_answers": {
        "disabled": [
          "不启用独立 CODE Reviewer"
        ],
        "enabled": [
          "启用独立 CODE Reviewer"
        ]
      },
      "next": "branch_create",
      "skip_in_moonlight": true,
      "moonlight_choice": "enabled"
    },
    "branch_create": {
      "title": "创建工作分支",
      "evidence": [
        {
          "type": "branch_ok"
        }
      ],
      "next_by": "workflow",
      "next": {
        "full": "grill",
        "hotfix": "hf_open",
        "tweak": "tw_open",
        "review": "rf_triage"
      }
    },
    "rf_triage": {
      "title": "处理评审意见 — 意见裁决",
      "evidence": [
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/{单号}/review.md"
          ]
        },
        {
          "type": "content_free",
          "file": ".mae-flow-work/{单号}/review.md",
          "patterns": [
            "待裁决"
          ],
          "note": "裁决未闭环:文档残留「待裁决」。每条意见须经 AskUserQuestion 拿用户确认后改为 修复(已确认)/反驳(已确认)/转规格轮次(已确认)"
        },
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        }
      ],
      "next": "rf_pace"
    },
    "rf_pace": {
      "title": "处理评审意见 — 开发节奏确认",
      "user_ack": true,
      "choice_key": "development_pace",
      "choices": [
        "staged",
        "continuous",
        "adjust"
      ],
      "choice_answers": {
        "staged": [
          "按检查点分阶段开发、推送和检视"
        ],
        "continuous": [
          "一次完成全部代码，最终统一检视"
        ],
        "adjust": [
          "调整检查点划分"
        ]
      },
      "evidence": [
        {
          "type": "checkpoint_plan"
        }
      ],
      "next": {
        "staged": "rf_fix",
        "continuous": "rf_fix",
        "adjust": "rf_pace"
      },
      "skip_in_moonlight": true,
      "moonlight_choice": "continuous"
    },
    "rf_fix": {
      "title": "处理评审意见 — 修改代码",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "review_fix_committed"
        },
        {
          "type": "checkpoint_plan_complete"
        }
      ],
      "next": "rf_compile"
    },
    "rf_compile": {
      "title": "处理评审意见 — 编译验证",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "COMPILE",
          "statuses": [
            "OK"
          ]
        }
      ],
      "next": "rf_review"
    },
    "rf_review": {
      "title": "处理评审意见 — 用户检视代码",
      "user_ack": true,
      "choice_key": "rf_review_decision",
      "choices": [
        "continue",
        "revise"
      ],
      "choice_answers": {
        "continue": [
          "我已认真检视并完成自验证，继续"
        ],
        "revise": [
          "需要调整代码"
        ]
      },
      "evidence": [
        {
          "type": "review_snapshot",
          "base_step": "rf_fix"
        }
      ],
      "next": {
        "continue": "rf_codecheck",
        "revise": "rf_fix"
      },
      "skip_in_moonlight": true,
      "moonlight_choice": "continue"
    },
    "rf_codecheck": {
      "title": "处理评审意见 — 规范检查",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "review_codecheck"
        }
      ],
      "next": "rf_ut"
    },
    "rf_ut": {
      "title": "处理评审意见 — 增量单元测试",
      "allow_source_edit": true,
      "tests_only": true,
      "source_change_recheck": "rf_compile",
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "UT",
          "statuses": [
            "PASS"
          ]
        }
      ],
      "next": "domain_archive"
    },
    "rf_verify": {
      "title": "处理评审意见 — 旧版验证迁移",
      "next": "rf_compile"
    },
    "grill_ask": {
      "title": "需求澄清询问",
      "user_ack": true,
      "choice_key": "grill",
      "choices": [
        "yes",
        "no"
      ],
      "choice_answers": {
        "yes": [
          "做需求质询",
          "做质询"
        ],
        "no": [
          "跳过需求质询",
          "跳过"
        ]
      },
      "next": {
        "yes": "grill",
        "no": "open"
      }
    },
    "grill": {
      "title": "需求澄清(逐题拍板)",
      "evidence": [
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/{单号}/grill-prep.md"
          ]
        },
        {
          "type": "content_free",
          "file": ".mae-flow-work/{单号}/grill-prep.md",
          "patterns": [
            "待填",
            "\\{\\{"
          ],
          "note": "备课工作表未填完:残留「待填」或「{{占位}}」。8 维每维必须替换掉全部 {{…}} 占位——给出实质结论(有缺口→候选题四要素齐全 / 不适用→具体依据),禁止快速划过某一维后重试"
        },
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/{单号}/decisions.md"
          ]
        },
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/{单号}/grill.md"
          ]
        },
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        },
        {
          "type": "agent_ran",
          "agent": "GRILL_PREP"
        },
        {
          "type": "agent_ran",
          "agent": "GRILL_FINAL"
        }
      ],
      "next": "open"
    },
    "open": {
      "title": "本地 Spec 确认",
      "user_ack": true,
      "confirmation_answers": [
        "Spec 内容已确认，生成 Story"
      ],
      "evidence": [
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/{单号}/spec.md",
            ".mae-flow-work/{单号}/grill.md"
          ]
        }
      ],
      "next": "story"
    },
    "design": {
      "title": "旧版方案设计恢复入口",
      "next": "story"
    },
    "test_blueprint": {
      "title": "旧版 UT 蓝图恢复入口",
      "next": "story"
    },
    "story_ask": {
      "title": "旧版 Story 选择恢复入口",
      "next": "story"
    },
    "story": {
      "title": "Story 生成与一次设计检视",
      "user_ack": true,
      "confirmation_answers": [
        "Story 已确认，进入开发节奏选择"
      ],
      "evidence": [
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/{单号}/story.md"
          ]
        },
        {
          "type": "agent_ran",
          "agent": "STORY",
          "statuses": [
            "DONE"
          ]
        },
        {
          "type": "agent_ran",
          "agent": "REVIEWER"
        },
        {
          "type": "content_free",
          "file": ".mae-flow-work/{单号}/story.md",
          "patterns": [
            "待确认"
          ],
          "note": "Story 仍有待确认内容；先展示给用户拍板，再完成本步骤唯一一次确认。"
        }
      ],
      "next": "build_pace"
    },
    "build_plan": {
      "title": "旧版编码计划恢复入口",
      "next": "build_pace"
    },
    "hf_open": {
      "title": "已定位问题修复 — 确认修改范围",
      "user_ack": true,
      "confirmation_answers": [
        "确认范围并继续"
      ],
      "evidence": [
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/{单号}/spec.md"
          ]
        }
      ],
      "next": "build_pace"
    },
    "tw_open": {
      "title": "局部修改 — 确认修改范围",
      "user_ack": true,
      "confirmation_answers": [
        "确认范围并继续"
      ],
      "evidence": [
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/{单号}/spec.md"
          ]
        }
      ],
      "next": "tw_pace"
    },
    "tw_pace": {
      "title": "局部修改 — 开发节奏确认",
      "user_ack": true,
      "choice_key": "development_pace",
      "choices": [
        "staged",
        "continuous",
        "adjust"
      ],
      "choice_answers": {
        "staged": [
          "按检查点分阶段开发、推送和检视"
        ],
        "continuous": [
          "一次完成全部代码，最终统一检视"
        ],
        "adjust": [
          "调整检查点划分"
        ]
      },
      "evidence": [
        {
          "type": "checkpoint_plan"
        }
      ],
      "next": {
        "staged": "tw_change",
        "continuous": "tw_change",
        "adjust": "tw_pace"
      },
      "skip_in_moonlight": true,
      "moonlight_choice": "continuous"
    },
    "tw_change": {
      "title": "局部修改 — 修改代码",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "tier_scope"
        },
        {
          "type": "commit_tagged_after_entry"
        },
        {
          "type": "checkpoint_plan_complete"
        }
      ],
      "next": "tw_compile"
    },
    "tw_compile": {
      "title": "小改 — 编译验证",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "COMPILE",
          "statuses": [
            "OK"
          ]
        }
      ],
      "next": "tw_review"
    },
    "tw_review": {
      "title": "小改 — 用户检视代码",
      "user_ack": true,
      "choice_key": "tw_review_decision",
      "choices": [
        "continue",
        "revise"
      ],
      "choice_answers": {
        "continue": [
          "我已认真检视并完成自验证，继续"
        ],
        "revise": [
          "需要调整代码"
        ]
      },
      "evidence": [
        {
          "type": "review_snapshot",
          "base_step": "tw_change"
        }
      ],
      "next": {
        "continue": "tw_codecheck",
        "revise": "tw_change"
      },
      "skip_in_moonlight": true,
      "moonlight_choice": "continue"
    },
    "tw_codecheck": {
      "title": "小改 — 规范检查",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "review_codecheck"
        }
      ],
      "next": "tw_ut"
    },
    "tw_ut": {
      "title": "小改 — 单元测试",
      "allow_source_edit": true,
      "tests_only": true,
      "source_change_recheck": "tw_compile",
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "UT",
          "statuses": [
            "PASS"
          ]
        }
      ],
      "next": "tw_verify"
    },
    "tw_verify": {
      "title": "小改 — 对照需求检查",
      "evidence": [
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/{单号}/verification.md"
          ]
        }
      ],
      "next": "domain_archive"
    },
    "build_pace": {
      "title": "编码前开发节奏确认",
      "user_ack": true,
      "choice_key": "development_pace",
      "choices": [
        "staged",
        "continuous",
        "adjust"
      ],
      "choice_answers": {
        "staged": [
          "按检查点分阶段开发、推送和检视"
        ],
        "continuous": [
          "一次完成全部代码，最终统一检视"
        ],
        "adjust": [
          "调整检查点划分"
        ]
      },
      "evidence": [
        {
          "type": "checkpoint_plan"
        }
      ],
      "next": {
        "staged": "build",
        "continuous": "build",
        "adjust": "build_pace"
      },
      "skip_in_moonlight": true,
      "moonlight_choice": "continuous"
    },
    "build": {
      "title": "编码实现",
      "clear_hint": true,
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "tier_scope"
        },
        {
          "type": "commit_tagged_after_entry"
        },
        {
          "type": "agent_or_no_source",
          "agent": "COMPILE",
          "statuses": [
            "OK"
          ]
        },
        {
          "type": "checkpoint_plan_complete"
        }
      ],
      "next": "build_review"
    },
    "build_review": {
      "title": "编码完成 — 用户检视代码",
      "user_ack": true,
      "choice_key": "build_review_decision",
      "choices": [
        "continue",
        "revise"
      ],
      "choice_answers": {
        "continue": [
          "我已认真检视并完成自验证，继续"
        ],
        "revise": [
          "需要调整代码"
        ]
      },
      "evidence": [
        {
          "type": "review_snapshot",
          "base_step": "build"
        }
      ],
      "next": {
        "continue": "verify_ponytail",
        "revise": "build"
      },
      "skip_in_moonlight": true,
      "moonlight_choice": "continue"
    },
    "verify_ponytail": {
      "title": "验证 1/4 — 代码精简(先删)",
      "clear_hint": true,
      "allow_source_edit": true,
      "source_change_next": "verify_post_ponytail_compile",
      "next": "verify_codecheck"
    },
    "verify_post_ponytail_compile": {
      "title": "验证 — 精简后重新编译",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "COMPILE",
          "statuses": [
            "OK"
          ]
        }
      ],
      "next": "verify_codecheck"
    },
    "verify_recompile": {
      "title": "验证回流 — 重新编译",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "COMPILE",
          "statuses": [
            "OK"
          ]
        }
      ],
      "next": "verify_ponytail"
    },
    "verify_codecheck": {
      "title": "验证 2/4 — 规范检查(代码定稿)",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "review_codecheck"
        }
      ],
      "next": "verify_ut"
    },
    "verify_ut": {
      "title": "验证 3/4 — 补充单元测试",
      "allow_source_edit": true,
      "tests_only": true,
      "source_change_recheck": "verify_recompile",
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "UT",
          "statuses": [
            "PASS"
          ]
        }
      ],
      "next": "verify_comet"
    },
    "verify_comet": {
      "title": "验证 4/4 — 规格符合性",
      "evidence": [
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/{单号}/verification.md"
          ]
        }
      ],
      "next": "domain_archive"
    },
    "domain_archive": {
      "title": "领域知识归档",
      "allow_specs_write": true,
      "evidence": [
        {
          "type": "domain_archive_complete"
        }
      ],
      "next": "delivery_review"
    },
    "delivery_review": {
      "title": "最终代码增量检视",
      "evidence": [
        {
          "type": "final_review_clear"
        }
      ],
      "next": "push",
      "skip_in_moonlight": true
    },
    "archive_confirm": {
      "title": "旧规格定稿确认恢复",
      "next": "domain_archive"
    },
    "archive": {
      "title": "旧规格定稿恢复",
      "next": "domain_archive"
    },
    "push": {
      "title": "推送分支",
      "dynamic_next": [
        "moonlight_review"
      ],
      "evidence": [
        {
          "type": "pushed"
        }
      ],
      "next": "end"
    },
    "moonlight_review": {
      "title": "月光宝盒 — 等待早晨检查",
      "next": "end"
    },
    "end": {
      "title": "交付完成",
      "terminal": true
    }
  }
}
