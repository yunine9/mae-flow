{
  "start": "env_setup",
  "state_file": ".mae-flow.json",
  "source_patterns": [
    "(^|/)(service|src)/"
  ],
  "specs_truth": "(^|/)openspec/specs/",
  "steps": {
    "env_setup": {
      "title": "环境就绪",
      "evidence": [
        {
          "type": "env_ok"
        }
      ],
      "next": "config_confirm"
    },
    "config_confirm": {
      "title": "配置确认",
      "user_ack": true,
      "require_sets": [
        "工号",
        "基线分支",
        "单号",
        "单号类型",
        "需求文档",
        "编译方式",
        "UT生成方式",
        "UT运行命令"
      ],
      "next": "workflow_select"
    },
    "workflow_select": {
      "title": "交付方式选择",
      "user_ack": true,
      "choice_key": "workflow",
      "choices": [
        "full",
        "hotfix",
        "tweak",
        "review"
      ],
      "next": "branch_create"
    },
    "branch_create": {
      "title": "创建工作分支",
      "evidence": [
        {
          "type": "branch_ok"
        }
      ],
      "next_by": "workflow",
      "next": {
        "full": "grill_ask",
        "hotfix": "hf_open",
        "tweak": "tw_open",
        "review": "rf_triage"
      }
    },
    "rf_triage": {
      "title": "评审返工 — 意见裁决",
      "user_ack": true,
      "evidence": [
        {
          "type": "glob",
          "any": [
            "docs/review/REVIEW-{单号}.md"
          ]
        },
        {
          "type": "content_free",
          "file": "docs/review/REVIEW-{单号}.md",
          "patterns": [
            "待裁决"
          ],
          "note": "裁决未闭环:文档残留「待裁决」。每条意见须经 AskUserQuestion 拿用户确认后改为 修复(已确认)/反驳(已确认)/转规格轮次(已确认)"
        },
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        },
        {
          "type": "clean_paths",
          "paths": [
            "docs/review/REVIEW-{单号}.md"
          ]
        }
      ],
      "next": "rf_fix"
    },
    "rf_fix": {
      "title": "评审返工 — 修复",
      "allow_source_edit": true,
      "user_ack": true,
      "evidence": [
        {
          "type": "commit_tagged"
        }
      ],
      "next": "rf_verify"
    },
    "rf_verify": {
      "title": "评审返工 — 增量验证",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "agent_ran",
          "agent": "CODECHECK"
        },
        {
          "type": "codecheck_clean"
        }
      ],
      "next": "push"
    },
    "grill_ask": {
      "title": "需求澄清询问",
      "user_ack": true,
      "choice_key": "grill",
      "choices": [
        "yes",
        "no"
      ],
      "next": {
        "yes": "grill",
        "no": "open"
      }
    },
    "grill": {
      "title": "需求澄清(逐题拍板)",
      "evidence": [
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/grill-prep-{单号}.md"
          ]
        },
        {
          "type": "content_free",
          "file": ".mae-flow-work/grill-prep-{单号}.md",
          "patterns": [
            "待填",
            "\\{\\{"
          ],
          "note": "备课工作表未填完:残留「待填」或「{{占位}}」。8 维每维必须替换掉全部 {{…}} 占位——给出实质结论(有缺口→候选题四要素齐全 / 不适用→具体依据),禁止快速划过某一维后重试"
        },
        {
          "type": "glob",
          "any": [
            "docs/clarifications-{单号}.md"
          ]
        },
        {
          "type": "clean_paths",
          "paths": [
            "docs/clarifications-{单号}.md"
          ]
        }
      ],
      "next": "open"
    },
    "open": {
      "title": "提案与规格",
      "evidence": [
        {
          "type": "glob",
          "any": [
            "openspec/changes/{CHANGE_NAME}/proposal.md"
          ]
        },
        {
          "type": "glob",
          "any": [
            "openspec/changes/{CHANGE_NAME}/specs/*/spec.md"
          ]
        },
        {
          "type": "glob",
          "any": [
            "openspec/changes/{CHANGE_NAME}/.comet.yaml"
          ]
        },
        {
          "type": "clean_paths",
          "paths": [
            "openspec/changes/{CHANGE_NAME}"
          ]
        },
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        }
      ],
      "next": "design",
      "require_sets": [
        "CHANGE_NAME"
      ]
    },
    "design": {
      "title": "方案设计",
      "evidence": [
        {
          "type": "yaml_field",
          "field": "design_doc"
        },
        {
          "type": "clean_paths",
          "paths": [
            "openspec/changes/{CHANGE_NAME}",
            "docs/superpowers"
          ]
        }
      ],
      "next": "story_ask"
    },
    "story_ask": {
      "title": "STORY 生成询问",
      "user_ack": true,
      "choice_key": "story",
      "choices": [
        "yes",
        "no"
      ],
      "next": {
        "yes": "story",
        "no": "build"
      }
    },
    "story": {
      "title": "生成 STORY",
      "require_sets": [
        "STORY入库"
      ],
      "evidence": [
        {
          "type": "glob",
          "any": [
            "docs/story/STORY-{单号}.md"
          ]
        },
        {
          "type": "agent_ran",
          "agent": "STORY"
        },
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        },
        {
          "type": "content_free",
          "file": "docs/story/STORY-{单号}.md",
          "patterns": [
            "待确认",
            "不涉及(?!\\s*[（(]\\s*已确认\\s*[）)])"
          ],
          "note": "待确认闭环未完成:文档残留『待确认』,或存在未经用户确认的裸『不涉及』。合法终态只有『不涉及(已确认)』——由你用 AskUserQuestion 拿到用户逐项拍板后亲自改写,agent 无权消除标注"
        }
      ],
      "next": "build"
    },
    "hf_open": {
      "title": "缺陷快修 — 轻量提案",
      "user_ack": true,
      "evidence": [
        {
          "type": "glob",
          "any": [
            "openspec/changes/{CHANGE_NAME}/.comet.yaml"
          ]
        }
      ],
      "next": "build",
      "require_sets": [
        "CHANGE_NAME"
      ]
    },
    "tw_open": {
      "title": "小改快过 — 轻量提案",
      "user_ack": true,
      "evidence": [
        {
          "type": "glob",
          "any": [
            "openspec/changes/{CHANGE_NAME}/.comet.yaml"
          ]
        }
      ],
      "next": "tw_change",
      "require_sets": [
        "CHANGE_NAME"
      ]
    },
    "tw_change": {
      "title": "小改快过 — 直接改动",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "commit_tagged"
        }
      ],
      "next": "tw_codecheck"
    },
    "tw_codecheck": {
      "title": "小改快过 — 规范检查(可跳过)",
      "allow_source_edit": true,
      "skippable": true,
      "evidence": [
        {
          "type": "codecheck_clean"
        }
      ],
      "next": "archive_confirm"
    },
    "build": {
      "title": "编码实现",
      "clear_hint": true,
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "tasks_checked"
        },
        {
          "type": "commit_tagged"
        },
        {
          "type": "agent_ran",
          "agent": "COMPILE"
        }
      ],
      "next": "verify_ponytail",
      "user_ack": true
    },
    "verify_ponytail": {
      "title": "验证 1/4 — 代码精简(先删)",
      "clear_hint": true,
      "allow_source_edit": true,
      "next": "verify_codecheck"
    },
    "verify_codecheck": {
      "title": "验证 2/4 — 规范检查(代码定稿)",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "agent_ran",
          "agent": "CODECHECK"
        },
        {
          "type": "codecheck_clean"
        }
      ],
      "next": "verify_ut"
    },
    "verify_ut": {
      "title": "验证 3/4 — 补充单元测试",
      "allow_source_edit": true,
      "tests_only": true,
      "evidence": [
        {
          "type": "agent_ran",
          "agent": "UT"
        }
      ],
      "next": "verify_comet"
    },
    "verify_comet": {
      "title": "验证 4/4 — 规格符合性",
      "evidence": [
        {
          "type": "yaml_field",
          "field": "verify_result",
          "equals": "pass"
        }
      ],
      "next": "archive_confirm"
    },
    "archive_confirm": {
      "title": "规格定稿确认(不可逆)",
      "user_ack": true,
      "evidence": [
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        }
      ],
      "next": "archive"
    },
    "archive": {
      "title": "规格定稿",
      "allow_specs_write": true,
      "skippable": true,
      "evidence": [
        {
          "type": "glob",
          "any": [
            "openspec/archive/*{CHANGE_NAME}*",
            "openspec/changes/archive/*{CHANGE_NAME}*"
          ]
        },
        {
          "type": "glob_absent",
          "any": [
            "openspec/changes/{CHANGE_NAME}/.comet.yaml"
          ],
          "note": "归档是移动不是复制:原 change 目录必须已从 openspec/changes/ 消失。仍在=复制式假归档(会变僵尸干扰后续 comet 检测),用 git mv 把目录移进 archive/ 而非 cp"
        },
        {
          "type": "clean_paths",
          "paths": [
            "openspec"
          ]
        }
      ],
      "next": "push"
    },
    "push": {
      "title": "推送分支",
      "evidence": [
        {
          "type": "pushed"
        }
      ],
      "next": "end"
    },
    "end": {
      "title": "交付完成",
      "terminal": true
    }
  },
  "env_checks": [
    {
      "name": "Node.js >= 20.19",
      "type": "node_min",
      "value": "20.19.0"
    },
    {
      "name": "OpenSpec CLI",
      "type": "cmd",
      "value": "openspec --version"
    },
    {
      "name": "Comet CLI",
      "type": "cmd",
      "value": "comet --version"
    },
    {
      "name": "Superpowers 插件",
      "type": "cmd_contains",
      "value": "codeagent plugin list",
      "contains": "superpowers"
    },
    {
      "name": "Ponytail 插件",
      "type": "cmd_contains",
      "value": "codeagent plugin list",
      "contains": "ponytail"
    },
    {
      "name": "CodeCheck 插件",
      "type": "cmd_contains",
      "value": "codeagent plugin list",
      "contains": "codecheck"
    },
    {
      "name": "CodeCheck 独立 CLI(fullcheck 可用)",
      "type": "cmd",
      "value": "codecheck fullcheck --help"
    },
    {
      "name": "git 仓库(项目根含 .git)",
      "type": "path_any",
      "value": [
        ".git"
      ]
    },
    {
      "name": "Comet 项目已 init 且已迁移(.cac/skills 就位)",
      "type": "path_any",
      "value": [
        ".cac/skills"
      ]
    },
    {
      "name": "skill 已加载(迁移后已重启会话,无待重启标记)",
      "type": "path_absent",
      "value": [
        ".mae-flow-need-reload"
      ]
    },
    {
      "name": "auto_transition 已关闭(.comet/config.yaml)",
      "type": "file_contains",
      "value": ".comet/config.yaml",
      "contains": "auto_transition: false"
    },
    {
      "name": "Git Bash(comet 全部 .sh 脚本的运行依赖)",
      "type": "cmd",
      "value": "bash --version"
    }
  ]
}
