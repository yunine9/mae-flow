{
  "start": "config_confirm",
  "state_file": ".mae-flow.json",
  "source_patterns": [
    "(^|/)(service|src|include|lib|app|modules?)/"
  ],
  "specs_truth": "(^|/)openspec/specs/",
  "steps": {
    "config_confirm": {
      "title": "配置确认",
      "user_ack": true,
      "require_sets": [
        "工号",
        "基线分支",
        "单号",
        "单号类型",
        "需求文档",
        "编译方式",
        "UT生成方式",
        "UT运行命令"
      ],
      "next": "workflow_select"
    },
    "workflow_select": {
      "title": "交付方式选择",
      "user_ack": true,
      "choice_key": "workflow",
      "choices": [
        "full",
        "hotfix",
        "tweak",
        "review"
      ],
      "choice_answers": {
        "full": [
          "完整开发"
        ],
        "hotfix": [
          "已定位问题修复"
        ],
        "tweak": [
          "局部修改"
        ],
        "review": [
          "处理评审意见"
        ]
      },
      "next": "branch_create"
    },
    "branch_create": {
      "title": "创建工作分支",
      "evidence": [
        {
          "type": "branch_ok"
        }
      ],
      "next_by": "workflow",
      "next": {
        "full": "grill_ask",
        "hotfix": "hf_open",
        "tweak": "tw_open",
        "review": "rf_triage"
      }
    },
    "rf_triage": {
      "title": "处理评审意见 — 意见裁决",
      "evidence": [
        {
          "type": "glob",
          "any": [
            "docs/review/REVIEW-{单号}.md"
          ]
        },
        {
          "type": "content_free",
          "file": "docs/review/REVIEW-{单号}.md",
          "patterns": [
            "待裁决"
          ],
          "note": "裁决未闭环:文档残留「待裁决」。每条意见须经 AskUserQuestion 拿用户确认后改为 修复(已确认)/反驳(已确认)/转规格轮次(已确认)"
        },
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        },
        {
          "type": "clean_paths",
          "paths": [
            "docs/review/REVIEW-{单号}.md"
          ]
        }
      ],
      "next": "rf_fix"
    },
    "rf_fix": {
      "title": "处理评审意见 — 修改代码",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "review_fix_committed"
        }
      ],
      "next": "rf_compile"
    },
    "rf_compile": {
      "title": "处理评审意见 — 编译验证",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "COMPILE",
          "statuses": [
            "OK"
          ]
        }
      ],
      "next": "rf_codecheck"
    },
    "rf_codecheck": {
      "title": "处理评审意见 — 规范检查",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "review_codecheck"
        }
      ],
      "next": "rf_ut"
    },
    "rf_ut": {
      "title": "处理评审意见 — 增量单元测试",
      "allow_source_edit": true,
      "tests_only": true,
      "source_change_recheck": "rf_compile",
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "UT",
          "statuses": [
            "PASS"
          ]
        }
      ],
      "next": "push"
    },
    "rf_verify": {
      "title": "处理评审意见 — 旧版验证迁移",
      "next": "rf_compile"
    },
    "grill_ask": {
      "title": "需求澄清询问",
      "user_ack": true,
      "choice_key": "grill",
      "choices": [
        "yes",
        "no"
      ],
      "choice_answers": {
        "yes": [
          "做需求质询",
          "做质询"
        ],
        "no": [
          "跳过需求质询",
          "跳过"
        ]
      },
      "next": {
        "yes": "grill",
        "no": "open"
      }
    },
    "grill": {
      "title": "需求澄清(逐题拍板)",
      "evidence": [
        {
          "type": "glob",
          "any": [
            ".mae-flow-work/grill-prep-{单号}.md"
          ]
        },
        {
          "type": "content_free",
          "file": ".mae-flow-work/grill-prep-{单号}.md",
          "patterns": [
            "待填",
            "\\{\\{"
          ],
          "note": "备课工作表未填完:残留「待填」或「{{占位}}」。8 维每维必须替换掉全部 {{…}} 占位——给出实质结论(有缺口→候选题四要素齐全 / 不适用→具体依据),禁止快速划过某一维后重试"
        },
        {
          "type": "glob",
          "any": [
            "docs/clarifications-{单号}.md"
          ]
        },
        {
          "type": "clean_paths",
          "paths": [
            "docs/clarifications-{单号}.md"
          ]
        },
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        }
      ],
      "next": "open"
    },
    "open": {
      "title": "提案与规格",
      "evidence": [
        {
          "type": "glob",
          "any": [
            "openspec/changes/{CHANGE_NAME}/change.md",
            "openspec/changes/{CHANGE_NAME}/proposal.md"
          ]
        },
        {
          "type": "spec_validate"
        },
        {
          "type": "clean_paths",
          "paths": [
            "openspec/changes/{CHANGE_NAME}"
          ]
        },
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        },
        {
          "type": "spec_field",
          "field": "phase"
        }
      ],
      "next": "design",
      "require_sets": [
        "CHANGE_NAME"
      ]
    },
    "design": {
      "title": "方案设计",
      "evidence": [
        {
          "type": "spec_field",
          "field": "design_doc"
        },
        {
          "type": "spec_validate",
          "placeholders": [
            "（待填",
            "（待设计"
          ]
        },
        {
          "type": "spec_field",
          "field": "phase",
          "equals": "build"
        },
        {
          "type": "clean_paths",
          "paths": [
            "openspec/changes/{CHANGE_NAME}"
          ]
        }
      ],
      "next": "story_ask"
    },
    "story_ask": {
      "title": "STORY 生成询问",
      "user_ack": true,
      "choice_key": "story",
      "choices": [
        "yes",
        "no"
      ],
      "choice_answers": {
        "yes": [
          "生成 STORY"
        ],
        "no": [
          "不生成 STORY"
        ]
      },
      "next": {
        "yes": "story",
        "no": "build"
      }
    },
    "story": {
      "title": "生成 STORY",
      "require_sets": [
        "STORY入库"
      ],
      "evidence": [
        {
          "type": "glob",
          "any": [
            "docs/story/STORY-{单号}.md"
          ]
        },
        {
          "type": "agent_ran",
          "agent": "STORY",
          "statuses": [
            "DONE",
            "NEEDS_CONFIRM"
          ]
        },
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        },
        {
          "type": "content_free",
          "file": "docs/story/STORY-{单号}.md",
          "patterns": [
            "待确认",
            "不涉及(?!\\s*[（(]\\s*已确认\\s*[）)])"
          ],
          "note": "待确认闭环未完成:文档残留『待确认』,或存在未经用户确认的裸『不涉及』。合法终态只有『不涉及(已确认)』——由你用 AskUserQuestion 拿到用户逐项拍板后亲自改写,agent 无权消除标注"
        }
      ],
      "next": "build"
    },
    "hf_open": {
      "title": "已定位问题修复 — 确认修改范围",
      "user_ack": true,
      "confirmation_answers": [
        "确认范围并继续"
      ],
      "evidence": [
        {
          "type": "spec_field",
          "field": "phase"
        },
        {
          "type": "spec_validate",
          "allow_empty": true
        }
      ],
      "next": "build",
      "require_sets": [
        "CHANGE_NAME"
      ]
    },
    "tw_open": {
      "title": "局部修改 — 确认修改范围",
      "user_ack": true,
      "confirmation_answers": [
        "确认范围并继续"
      ],
      "evidence": [
        {
          "type": "spec_field",
          "field": "phase"
        },
        {
          "type": "spec_validate",
          "allow_empty": true
        }
      ],
      "next": "tw_change",
      "require_sets": [
        "CHANGE_NAME"
      ]
    },
    "tw_change": {
      "title": "局部修改 — 修改代码",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "tier_scope"
        },
        {
          "type": "commit_tagged_after_entry"
        }
      ],
      "next": "tw_compile"
    },
    "tw_compile": {
      "title": "小改 — 编译验证",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "COMPILE",
          "statuses": [
            "OK"
          ]
        }
      ],
      "next": "tw_codecheck"
    },
    "tw_codecheck": {
      "title": "小改 — 规范检查",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "review_codecheck"
        }
      ],
      "next": "tw_ut"
    },
    "tw_ut": {
      "title": "小改 — 单元测试",
      "allow_source_edit": true,
      "tests_only": true,
      "source_change_recheck": "tw_compile",
      "evidence": [
        {
          "type": "agent_or_no_source",
          "agent": "UT",
          "statuses": [
            "PASS"
          ]
        }
      ],
      "next": "tw_verify"
    },
    "tw_verify": {
      "title": "小改 — 对照需求检查",
      "evidence": [
        {
          "type": "spec_field",
          "field": "verify_result",
          "equals": "pass"
        }
      ],
      "next": "archive_confirm"
    },
    "build": {
      "title": "编码实现",
      "clear_hint": true,
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "tier_scope"
        },
        {
          "type": "tasks_checked"
        },
        {
          "type": "commit_tagged_after_entry"
        },
        {
          "type": "agent_ran",
          "agent": "COMPILE",
          "statuses": [
            "OK"
          ]
        }
      ],
      "next": "verify_ponytail"
    },
    "verify_ponytail": {
      "title": "验证 1/4 — 代码精简(先删)",
      "clear_hint": true,
      "allow_source_edit": true,
      "source_change_next": "verify_post_ponytail_compile",
      "next": "verify_codecheck"
    },
    "verify_post_ponytail_compile": {
      "title": "验证 — 精简后重新编译",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "agent_ran",
          "agent": "COMPILE",
          "statuses": [
            "OK"
          ]
        }
      ],
      "next": "verify_codecheck"
    },
    "verify_recompile": {
      "title": "验证回流 — 重新编译",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "agent_ran",
          "agent": "COMPILE",
          "statuses": [
            "OK"
          ]
        }
      ],
      "next": "verify_ponytail"
    },
    "verify_codecheck": {
      "title": "验证 2/4 — 规范检查(代码定稿)",
      "allow_source_edit": true,
      "evidence": [
        {
          "type": "review_codecheck"
        }
      ],
      "next": "verify_ut"
    },
    "verify_ut": {
      "title": "验证 3/4 — 补充单元测试",
      "allow_source_edit": true,
      "tests_only": true,
      "source_change_recheck": "verify_recompile",
      "evidence": [
        {
          "type": "agent_ran",
          "agent": "UT",
          "statuses": [
            "PASS"
          ]
        }
      ],
      "next": "verify_comet"
    },
    "verify_comet": {
      "title": "验证 4/4 — 规格符合性",
      "evidence": [
        {
          "type": "spec_field",
          "field": "verify_result",
          "equals": "pass"
        }
      ],
      "next": "archive_confirm"
    },
    "archive_confirm": {
      "title": "规格定稿确认(不可逆)",
      "user_ack": true,
      "confirmation_answers": [
        "确认定稿"
      ],
      "evidence": [
        {
          "type": "agent_ran",
          "agent": "ASKUSER"
        }
      ],
      "next": "archive"
    },
    "archive": {
      "title": "规格定稿",
      "allow_specs_write": true,
      "evidence": [
        {
          "type": "glob",
          "any": [
            "openspec/changes/archive/*{CHANGE_NAME}*"
          ]
        },
        {
          "type": "glob_absent",
          "any": [
            "openspec/changes/{CHANGE_NAME}/change.md",
            "openspec/changes/{CHANGE_NAME}/proposal.md",
            "openspec/changes/{CHANGE_NAME}/tasks.md"
          ],
          "note": "定稿是移动不是复制:原变更目录必须已从 openspec/changes/ 消失。仍在=复制式假定稿(会干扰后续在建区判定),用 spec archive 完成移动"
        },
        {
          "type": "spec_field",
          "field": "phase",
          "equals": "archived"
        },
        {
          "type": "clean_paths",
          "paths": [
            "openspec"
          ]
        }
      ],
      "next": "push"
    },
    "push": {
      "title": "推送分支",
      "evidence": [
        {
          "type": "pushed"
        }
      ],
      "next": "end"
    },
    "moonlight_review": {
      "title": "月光宝盒 — 等待早晨检查",
      "next": "end"
    },
    "end": {
      "title": "交付完成",
      "terminal": true
    }
  }
}
